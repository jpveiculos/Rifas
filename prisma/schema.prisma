generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RaffleStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum NumberStatus {
  AVAILABLE
  RESERVED
  CONFIRMED
}

enum ParticipationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Raffle {
  id             String        @id @default(cuid())
  name           String
  productName    String
  description    String        @db.Text
  imageUrls      String[]      @default([])
  totalNumbers   Int
  priceInCents   Int
  endDate        DateTime?
  status         RaffleStatus  @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  numbers        RaffleNumber[]
  participations RaffleParticipation[]
}

model User {
  id           String    @id @default(cuid())
  name         String
  city         String
  whatsapp     String
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  numbers        RaffleNumber[]
  participations RaffleParticipation[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RaffleNumber {
  id                 String       @id @default(cuid())
  raffleId           String
  number             Int
  status             NumberStatus @default(AVAILABLE)
  reservationId      String?
  reservedAt         DateTime?
  confirmedAt        DateTime?
  reservedByUserId   String?
  raffle             Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  reservedByUser     User?        @relation(fields: [reservedByUserId], references: [id], onDelete: SetNull)

  @@unique([raffleId, number])
  @@index([raffleId, status])
  @@index([reservedByUserId])
  @@index([raffleId, reservationId])
}

model RaffleParticipation {
  id                           String              @id @default(cuid())
  raffleId                    String
  userId                      String
  reservationId               String              @unique
  quantity                    Int
  amountInCents                Int
  status                      ParticipationStatus @default(PENDING)
  mercadopagoOrderId           String?             @unique
  mercadopagoStatus            String?
  mercadopagoStatusDetail      String?
  mercadopagoPaidAmountInCents Int?
  mercadopagoQrCode            String?             @db.Text
  mercadopagoQrCodeBase64      String?             @db.Text
  mercadopagoTicketUrl         String?             @db.Text
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  approvedAt                   DateTime?

  raffle                       Raffle              @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  user                         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([raffleId, status])
  @@index([userId, createdAt])
  @@index([mercadopagoOrderId])
}
