generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RaffleStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum NumberStatus {
  AVAILABLE
  RESERVED
  CONFIRMED
}

enum ParticipationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RaffleResultStatus {
  PENDING
  ACCUMULATED
  WINNER
}

model SiteSettings {
  id             Int      @id @default(1)
  contactWhatsapp String   @default("77998315360")
  instagramHandle String   @default("rifastop.com.br")
  updatedAt      DateTime @updatedAt
}

model RaffleTopic {
  id          String   @id @default(cuid())
  name        String
  normalized  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  raffles     Raffle[]

  @@index([name])
}

model Raffle {
  id                   String             @id @default(cuid())
  raffleCode           String?            @unique
  name                 String
  city                 String             @default("")
  topicId              String?
  topic                RaffleTopic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  productName          String
  description          String             @db.Text
  imageUrls            String[]           @default([])
  totalNumbers         Int
  priceInCents         Int
  endDate              DateTime?
  status               RaffleStatus       @default(DRAFT)
  salesClosedAt        DateTime?
  drawEligibleCount    Int?
  winningNumber        Int?
  winningNumbers       Int[]              @default([])
  federalNumbers       String[]           @default([])
  resultStatus         RaffleResultStatus @default(PENDING)
  resultPublishedAt    DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  numbers              RaffleNumber[]
  participations       RaffleParticipation[]
  marketingCampaigns   MarketingCampaign[]

  @@index([topicId])
}

model User {
  id             String    @id @default(cuid())
  name           String
  city           String
  whatsapp       String
  username       String    @unique
  passwordHash   String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       Session[]
  numbers        RaffleNumber[]
  participations RaffleParticipation[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RaffleNumber {
  id                 String       @id @default(cuid())
  raffleId           String
  number             Int
  status             NumberStatus @default(AVAILABLE)
  reservationId      String?
  reservedAt         DateTime?
  confirmedAt        DateTime?
  reservedByUserId   String?
  raffle             Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  reservedByUser     User?        @relation(fields: [reservedByUserId], references: [id], onDelete: SetNull)

  @@unique([raffleId, number])
  @@index([raffleId, status])
  @@index([reservedByUserId])
  @@index([raffleId, reservationId])
}

model RaffleParticipation {
  id                           String              @id @default(cuid())
  raffleId                    String
  userId                      String
  reservationId               String              @unique
  quantity                    Int
  amountInCents                Int
  status                       ParticipationStatus @default(PENDING)
  mercadopagoOrderId           String?             @unique
  mercadopagoStatus            String?
  mercadopagoStatusDetail      String?
  mercadopagoPaidAmountInCents Int?
  mercadopagoQrCode            String?             @db.Text
  mercadopagoQrCodeBase64      String?             @db.Text
  mercadopagoTicketUrl         String?             @db.Text
  mercadopagoExpiresAt         DateTime?
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt
  approvedAt                   DateTime?

  raffle                       Raffle              @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  user                         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([raffleId, status])
  @@index([userId, createdAt])
  @@index([mercadopagoOrderId])
}


model MarketingCampaign {
  id              String            @id
  name            String
  raffleId        String
  objective       String
  budgetCents     Int               @default(0)
  destinationType String            @default("HOME")
  status          String            @default("READY")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  raffle          Raffle            @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  variants        MarketingVariant[]

  @@index([raffleId])
}

model MarketingVariant {
  id              String            @id
  campaignId      String
  city            String
  distanceKm      Int               @default(0)
  creativeType    String            @default("SITE")
  caption         String            @db.Text
  trackingCode    String            @unique
  destinationPath String
  createdAt       DateTime          @default(now())
  campaign        MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  metric          MarketingMetric?
  clicks          MarketingClick[]

  @@index([campaignId])
}

model MarketingMetric {
  id             String          @id
  variantId      String          @unique
  spendCents     Int             @default(0)
  impressions    Int             @default(0)
  reach          Int             @default(0)
  engagements    Int             @default(0)
  profileVisits  Int             @default(0)
  linkClicks     Int             @default(0)
  registrations  Int             @default(0)
  participations Int             @default(0)
  updatedAt      DateTime        @updatedAt
  variant        MarketingVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model MarketingClick {
  id           String           @id
  trackingCode String
  createdAt    DateTime         @default(now())
  referrer     String?
  userAgent    String?
  variant      MarketingVariant @relation(fields: [trackingCode], references: [trackingCode], onDelete: Cascade)

  @@index([trackingCode])
  @@index([createdAt])
}

model MetaIntegration {
  id                  Int       @id @default(1)
  accessTokenEncrypted String?
  tokenExpiresAt      DateTime?
  metaUserId          String?
  metaUserName        String?
  adAccountId         String?
  adAccountName       String?
  facebookPageId      String?
  facebookPageName    String?
  instagramAccountId  String?
  instagramUsername   String?
  connectedAt         DateTime?
  updatedAt           DateTime  @updatedAt
}
