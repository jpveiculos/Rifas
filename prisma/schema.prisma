generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RaffleStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum NumberStatus {
  AVAILABLE
  RESERVED
  CONFIRMED
}

model Raffle {
  id             String        @id @default(cuid())
  name           String
  productName    String
  description    String        @db.Text
  totalNumbers   Int
  priceInCents   Int
  endDate        DateTime?
  status         RaffleStatus  @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  numbers        RaffleNumber[]
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  whatsapp     String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  numbers      RaffleNumber[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RaffleNumber {
  id              String       @id @default(cuid())
  raffleId        String
  number          Int
  status          NumberStatus @default(AVAILABLE)
  reservationId   String?
  reservedAt      DateTime?
  confirmedAt     DateTime?
  reservedByUserId String?
  raffle          Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  reservedByUser  User?        @relation(fields: [reservedByUserId], references: [id], onDelete: SetNull)

  @@unique([raffleId, number])
  @@index([raffleId, status])
  @@index([reservedByUserId])
}